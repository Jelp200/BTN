---
// BiometricCharts.astro - Gráfica única de métricas biométricas con selector
---

<div class="bg-white rounded-md border border-[#a6a6a6] p-2 w-full">
    <div class="flex items-center justify-between mb-4">
        <h3 class="text-sm font-semibold text-[#111827]">Métricas Biométricas</h3>
        
        <!-- Selector de métrica -->
        <select id="biometricMetricSelector" class="px-3 py-1 border border-[#a6a6a6] rounded bg-white text-sm">
            <option value="pulse">Pulso (bpm)</option>
            <option value="oxygen">Oxigenación (%)</option>
            <option value="temperature">Temperatura (°C)</option>
            <option value="glucose">Glucosa (mg/dL)</option>
        </select>
    </div>
    
    <!-- Canvas para la gráfica con contenedor sizing específico -->
    <div class="relative w-full overflow-hidden bg-gray-50 rounded" style="min-height: 300px;">
        <canvas id="biometricChart"></canvas>
    </div>
</div>

<script>
    // Debugging: verificar que el canvas existe
    document.addEventListener("DOMContentLoaded", () => {
        const canvas = document.getElementById("biometricChart");
        console.log("[BiometricCharts.astro] Canvas existe:", !!canvas);
        if (canvas) {
            console.log("[BiometricCharts.astro] Canvas dimensiones iniciales:", {
                width: canvas.width,
                height: canvas.height,
                offsetWidth: canvas.offsetWidth,
                offsetHeight: canvas.offsetHeight
            });
        }
    });
</script>

