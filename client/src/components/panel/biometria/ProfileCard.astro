<!-- ProfileCard.astro -->
<div
    class="bg-[#e6e6e6] border border-[#bababa] rounded-lg p-3 flex flex-col items-center gap-3"
>
    <img src="/icons/user-silhouette.svg" alt="Usuario" class="w-35 h-35" />
    <div class="text-lg text-[#111827]">Usuario</div>
    <div class="w-full flex gap-2">
        <button
            class="flex-1 bg-[#00BF63] hover:bg-[#00A853] text-white font-semibold rounded-xl py-2 transition-all flex items-center justify-center gap-2"
            data-action="connect-watch"
        >
            <img src="/icons/connect_bt.svg" alt="Conectar" class="w-5 h-5" />
        </button>
        <button
            class="flex-1 bg-[#ff6b6b] hover:bg-[#e85c5c] text-white font-semibold rounded-xl py-2 transition-all flex items-center justify-center gap-2"
            data-action="disconnect-watch"
        >
            <img
                src="/icons/disconnect_bt.svg"
                alt="Desconectar"
                class="w-5 h-5"
            />
        </button>
    </div>
</div>
