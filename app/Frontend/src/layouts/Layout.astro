---
//* ESTILOS
import "../styles/global.css";

//* COMPONENTES
import Loader from "../components/Loader.astro";

//* PROPS
export interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/logos/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- XLSX library for Excel export (bundled locally) -->
	</head>
	<body>
		<!-- Sistema de toasts (carga primero para interceptar window.alert) -->
		<script is:inline src="/scripts/toast.js"></script>

		<!-- Expone XLSX como global window.XLSX desde node_modules (sin CDN externo) -->
		<script>
			import * as XLSX from 'xlsx';
			(window as any).XLSX = XLSX;
		</script>

		<!-- Loader/Splash Screen -->
		<!-- <Loader waitMs={8000} /> -->

		<!-- Contenido principal -->
		<slot />
	</body>
