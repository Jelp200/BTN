---
//* Loader.astro *//
interface Props {
    waitMs: number;
}

const { waitMs = 8000 } = Astro.props;
---

<div
    id="splash-screen"
    class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-white transition-opacity duration-700"
    data-wait-ms={waitMs}
>
    <!-- Contenedor principal con layout vertical -->
    <div class="flex-1 flex flex-col items-center justify-center gap-8">
        <!-- Círculo con gradiente del centro hacia afuera -->
        <div 
            class="relative h-40 w-40 flex items-center justify-center rounded-full"
            style="background: radial-gradient(circle, #cfcfcf 0%, #ffffff 70%, #000000 100%);"
        >
            <!-- Efecto de pulse sobre el gradiente -->
            <div
                class="absolute inset-0 animate-ping rounded-full opacity-30"
                style="background: radial-gradient(circle, #5e5e5e, transparent);"
            >
            </div>
            
            <!-- Logo de GITSE en el centro -->
            <div class="relative z-10 flex items-center justify-center h-60 w-60">
                <img 
                    src="/logos/GT_logoColores.svg" 
                    alt="Gradus Tech Logo" 
                    class="h-full w-full object-contain filter drop-shadow-lg"
                />
            </div>
        </div>

        <!-- Texto de carga -->
        <div class="flex flex-col items-center justify-center space-y-1">
            
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-center tracking-[0.35em]">
                <span class="text-[#5e17eb]">G</span>
                <span class="text-[#ffbd59]">R</span>
                <span class="text-[#0cc0df]">A</span>
                <span class="text-[#7ed957]">D</span>
                <span class="text-[#ff5757]">U</span>
                <span class="text-[#000000]">S</span>
            </h1>

            <h2 class="text-gray-700 text-xs sm:text-sm md:text-base font-light tracking-widest uppercase">
                Technologies
            </h2>

        </div>
    </div>

    <!-- Barra de carga -->
    <div class="w-64 h-1 bg-gray-300 rounded-full overflow-hidden mb-8">
        <div 
            id="progress-bar"
            class="h-full bg-blue-500 transition-all ease-linear"
            style="width: 0%;"
        ></div>
    </div>

    <!-- Footer con créditos de Gradus Tech -->
    <div class="pb-8 flex flex-col items-center gap-3">
        <div class="flex flex-col items-center gap-2">
            <img 
                src="/logos/GT_logoColores.svg" 
                alt="Gradus Tech" 
                class="h-12 w-12 object-contain opacity-75"
            />
            <span class="text-gray-400 text-xs font-light">Realizado por Gradus Tech</span>
        </div>
    </div>
</div>

<script type="module" src="/scripts/loaderAnimation.js"></script>