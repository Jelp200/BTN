---
//* Loader.astro *//
interface Props {
    waitMs: number;
}

const { waitMs = 8000 } = Astro.props;
---

<style>
    @font-face {
        font-family: '911Porscha';
        src: url('/fonts/911porschav3laser.ttf') format('truetype');
        font-weight: normal;
        font-style: normal;
        font-display: block;
    }
</style>

<div
    id="splash-screen"
    class="fixed inset-0 z-50 flex flex-col items-center justify-between bg-white transition-opacity duration-700"
    data-wait-ms={waitMs}
>

    <!-- Contenido central -->
    <div class="flex flex-col items-center justify-center flex-1 gap-10">

        <!-- Logo container -->
        <div class="relative flex items-center justify-center">

            <!-- Halo animado -->
            <div class="absolute w-52 h-52 rounded-full blur-2xl opacity-40 animate-pulse"
                style="background: radial-gradient(circle, #1f497d55, transparent 70%);">
            </div>

            <!-- Anillo giratorio -->
            <div class="absolute w-44 h-44 rounded-full border-2 border-gray-200 border-t-[#1f497d] animate-spin"></div>

            <!-- Logo -->
            <img
                src="/logos/logo-gitse.svg"
                alt="GITSE Logo"
                class="relative h-24 w-24 object-contain drop-shadow-lg"
            />

        </div>


        <!-- Texto -->
        <div class="flex flex-col items-center gap-2 text-center">

            <h1 class="text-2xl sm:text-3xl md:text-4xl tracking-wide" style="font-family: '911Porscha', sans-serif;">
                <span class="text-[#1f497d]">G</span><span class="text-[#cc9900]">estión e</span>
                <span class="text-[#1f497d]">I</span><span class="text-[#cc9900]">nnovación en</span>
                <span class="text-[#1f497d]">T</span><span class="text-[#cc9900]">ecnológica</span>
                <span class="text-[#1f497d]">S</span><span class="text-[#cc9900]">ocial</span>
            </h1>

            <span class="text-gray-500 text-xs tracking-[0.4em] uppercase">
                México
            </span>

            <p class="text-gray-400 text-xs animate-pulse mt-2">
                Inicializando plataforma...
            </p>

        </div>

    </div>


    <!-- Progress bar -->
    <div class="w-72 mb-10">

        <div class="w-full h-0.75 bg-gray-200 rounded-full overflow-hidden">

            <div
                id="progress-bar"
                class="h-full bg-linear-to-r from-[#1f497d] via-[#3b6cb7] to-[#cc9900] transition-all duration-300 ease-linear"
                style="width: 0%"
            ></div>

        </div>

    </div>


    <!-- Footer -->
    <div class="pb-8 flex flex-col items-center gap-2 opacity-70">

        <img
            src="/logos/GT_logoColores.svg"
            alt="Gradus Tech"
            class="h-10 w-30 object-contain"
        />

        <span class="text-gray-400 text-[11px] tracking-wide">
            Powered by Gradus Tech
        </span>

    </div>

</div>

<script type="module" src="/scripts/loaderAnimation.js"></script>