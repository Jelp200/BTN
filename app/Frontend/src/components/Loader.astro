---
//* Loader.astro *//
interface Props {
    waitMs: number;
}

const { waitMs = 8000 } = Astro.props;
---

<style is:global>
    @font-face {
        font-family: '911Porscha';
        src: url('/fonts/911porschav3laser.ttf') format('truetype');
        font-weight: normal;
        font-style: normal;
        font-display: block;
    }

    /* Hexágonos del fondo interactivo */
    .hex-cell {
        position: absolute;
        clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
        background: #ffffff;
        transition: transform 0.06s ease;
        will-change: transform, background;
    }
</style>

<div
    id="splash-screen"
    class="fixed inset-0 z-50 flex flex-col items-center justify-between transition-opacity duration-700"
    style="background-color: #eef0f4;"
    data-wait-ms={waitMs}
>
    <!-- Fondo de panal interactivo -->
    <div id="hex-grid" class="absolute inset-0 overflow-hidden"></div>

    <!-- Contenido central -->
    <div class="relative z-10 pointer-events-none flex flex-col items-center justify-center flex-1 gap-10">

        <!-- Logo container -->
        <div class="relative flex items-center justify-center">

            <!-- Halo animado -->
            <div class="absolute w-52 h-52 rounded-full blur-2xl opacity-40 animate-pulse"
                style="background: radial-gradient(circle, #1f497d55, transparent 70%);">
            </div>

            <!-- Anillo giratorio -->
            <div class="absolute w-44 h-44 rounded-full border-2 border-gray-200 border-t-[#1f497d] animate-spin"></div>

            <!-- Logo -->
            <img
                src="/logos/logo-cp.svg"
                alt="Control Panel Logo"
                class="relative h-24 w-24 object-contain drop-shadow-lg"
            />

        </div>


        <!-- Texto -->
        <div class="flex flex-col items-center gap-2 text-center">

            <h1 class="text-2xl sm:text-3xl md:text-4xl tracking-wide" style="font-family: '911Porscha', sans-serif;">
                <span class="text-[#000000]">Control </span><span class="text-[#696969]">Panel</span>
                <br>
                <span class="text-[#3b692d]">███</span><span class="text-[#ffffff]">█</span><span class="text-[#5a3217]">█</span><span class="text-[#ffffff]">█</span><span class="text-[#c01e1e]">███</span>
            </h1>

            <span class="text-gray-500 text-xs tracking-[0.4em] uppercase">
                V-2.0.4
            </span>

            <p class="text-gray-400 text-xs animate-pulse mt-2">
                Inicializando plataforma...
            </p>

        </div>

    </div>


    <!-- Progress bar -->
    <div class="relative z-10 pointer-events-none w-72 mb-10">

        <div class="w-full h-0.75 bg-gray-200 rounded-full overflow-hidden">

            <div
                id="progress-bar"
                class="h-full bg-linear-to-r from-[#1f497d] via-[#3b6cb7] to-[#cc9900] transition-all duration-300 ease-linear"
                style="width: 0%"
            ></div>

        </div>

    </div>


    <!-- Footer -->
    <div class="relative z-10 pointer-events-none pb-8 flex flex-col items-center gap-2 opacity-70">

        <img
            src="/logos/GT_logoColores.svg"
            alt="Gradus Tech"
            class="h-10 w-30 object-contain"
        />

        <span class="text-gray-400 text-[11px] tracking-wide">
            Powered by Gradus Tech
        </span>

    </div>

</div>

<script type="module" src="/scripts/loaderAnimation.js"></script>