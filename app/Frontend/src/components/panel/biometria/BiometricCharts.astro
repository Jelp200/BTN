---
// BiometricCharts.astro - Gráfica única de métricas biométricas con selector y modos de medición
---

<div class="bg-white rounded-md border border-[#a6a6a6] p-2 w-full biometric-charts-container">

    <!-- Encabezado: título | botones de modo | selector -->
    <div class="flex items-center gap-2 mb-3 flex-wrap">
        <h3 class="text-sm font-semibold text-[#111827] shrink-0">Métricas Biométricas</h3>

        <!-- Botones de modo (habilitados tras primera medición BPM) -->
        <div class="flex items-center gap-1.5">

            <!-- Modo Automático -->
            <button
                data-biometric-mode="auto"
                class="biometric-mode-btn flex items-center gap-1 px-2.5 py-1 border-2 border-[#00bf63] rounded-md text-[11px] font-semibold text-[#00bf63] bg-white transition-all duration-200 opacity-35 cursor-not-allowed select-none"
                disabled
                title="Ciclo automático: BPM → SpO2 → Temp → Presión → descanso 5 min → repite"
            >
                <!-- Icono refresh/ciclo -->
                <svg viewBox="0 0 20 20" fill="currentColor" style="width:12px;height:12px;flex-shrink:0">
                    <path fill-rule="evenodd" d="M4 2a1 1 0 011 1v2.101a7.002 7.002 0 0111.601 2.566 1 1 0 11-1.885.666A5.002 5.002 0 005.999 7H9a1 1 0 010 2H4a1 1 0 01-1-1V3a1 1 0 011-1zm.008 9.057a1 1 0 011.276.61A5.002 5.002 0 0014.001 13H11a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0v-2.101a7.002 7.002 0 01-11.601-2.566 1 1 0 01.61-1.276z" clip-rule="evenodd"/>
                </svg>
                Automática
            </button>

            <!-- Modo Por Evento -->
            <button
                data-biometric-mode="event"
                class="biometric-mode-btn flex items-center gap-1 px-2.5 py-1 border-2 border-[#ef4444] rounded-md text-[11px] font-semibold text-[#ef4444] bg-white transition-all duration-200 opacity-35 cursor-not-allowed select-none"
                disabled
                title="Por evento: la medición inicia al cambiar el selector"
            >
                <!-- Icono rayo/evento -->
                <svg viewBox="0 0 20 20" fill="currentColor" style="width:12px;height:12px;flex-shrink:0">
                    <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
                </svg>
                Por evento
            </button>
        </div>

        <!-- Selector de métrica -->
        <select class="biometric-metric-selector ml-auto px-3 py-1 border border-[#a6a6a6] rounded bg-white text-sm">
            <option value="pulse">Pulso (bpm)</option>
            <option value="oxygen">Oxigenación (%)</option>
            <option value="temperature">Temperatura (°C)</option>
            <option value="bloodPressure">Presión Arterial (mmHg)</option>
        </select>
    </div>

    <!-- Barra de estado del modo activo (oculta por defecto) -->
    <div class="biometric-mode-status hidden text-[11px] text-center py-1 px-3 mb-2 rounded-md font-medium"></div>

    <!-- Canvas de la gráfica -->
    <div class="relative w-full overflow-hidden bg-gray-50 rounded biometric-chart-container" style="min-height: 300px;">
        <canvas class="biometric-chart"></canvas>
    </div>
</div>

<script>
    // Debugging: verificar que el canvas existe
    document.addEventListener("DOMContentLoaded", () => {
        const canvases = document.querySelectorAll(".biometric-chart") as NodeListOf<HTMLCanvasElement>;
        console.log("[BiometricCharts.astro] Cantidad de canvas encontrados:", canvases.length);
        canvases.forEach((canvas, idx) => {
            console.log(`[BiometricCharts.astro] Canvas ${idx} dimensiones iniciales:`, {
                width: canvas.width,
                height: canvas.height,
                offsetWidth: canvas.offsetWidth,
                offsetHeight: canvas.offsetHeight
            });
        });    });
</script>