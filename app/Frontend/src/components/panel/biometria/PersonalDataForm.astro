<!-- PersonalDataForm.astro -->
<div class="personal-data-form-container">
    <div class="text-sm text-[#374151] mb-2">Datos personales:</div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
        <div>
            <div class="text-sm font-semibold mb-1">Edad</div>
            <input
                class="personal-age text-sm w-full px-3 py-2 bg-white border border-[#bababa] rounded-lg"
                placeholder="0 ~ 99"
                type="number"
            />
        </div>
        <div>
            <div class="text-sm font-semibold mb-1">Altura y Peso</div>
            <div class="flex gap-2">
                <input
                    class="personal-height text-sm w-full px-3 py-2 bg-white border border-[#bababa] rounded-lg"
                    placeholder="0 ~ 191 cm"
                    type="number"
                />
                <input
                    class="personal-weight text-sm w-full px-3 py-2 bg-white border border-[#bababa] rounded-lg"
                    placeholder="0 ~ 100 kg"
                    type="number"
                />
            </div>
        </div>
        <div>
            <div class="text-sm font-semibold mb-1">Género</div>
            <select
                class="personal-gender text-sm w-full px-3 py-2 bg-white border border-[#bababa] rounded-lg"
            >
                <option>Hombre</option>
                <option>Mujer</option>
                <option>Indefinido</option>
            </select>
        </div>
    </div>

    <div class="mt-3 flex justify-end gap-2">
        <button
            class="bg-[#00BF63] hover:bg-[#00a152] text-white rounded-lg px-4 py-2 flex items-center gap-2"
            data-action="accept-personal-data"
        >
            <img src="/icons/check.svg" alt="OK" class="w-4 h-4" />
        </button>
        <button
            class="bg-[#ff6b6b] hover:bg-[#e85c5c] text-white rounded-lg px-4 py-2 flex items-center gap-2"
            data-action="cancel-personal-data"
        >
            <img src="/icons/close.svg" alt="Cancelar" class="w-4 h-4" />
        </button>
    </div>
</div>