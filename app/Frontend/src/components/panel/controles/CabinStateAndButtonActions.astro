---
//* CabinStateAndButtonActions.astro *//
---

<div class="flex items-center justify-between">
    <!-- Círculo de estado con texto -->
    <div
        id="estado-cabina"
        class="w-30 h-8 rounded-xl bg-[#ff5757] text-white flex items-center justify-center gap-2 text-s font-semibold shadow-inner transition-colors"
    >
        <img src="/icons/active-inactive.svg" alt="CSV" class="w-5 h-5" />
        INACTIVA
    </div>

    <!-- Botones Enviar y Parar a la derecha -->
    <div class="flex gap-2">
        <button
            id="btn-enviar-configuracion"
            class="bg-[#00bf63] hover:bg-[#028646cd] text-white font-medium px-3 py-1 rounded-xl transition-colors"
        >
            ACTIVAR CABINA
        </button>
        <button
            id="btn-parar-reset"
            class="bg-[#ff5757] hover:bg-[#fa3a3a] text-white font-medium px-3 py-1 rounded-xl transition-colors"
        >
            PARAR Y RESET
        </button>
    </div>
</div>