---
// LedButton.astro

const { label, colIndex, rowIndex, inactiveColor = "#e84e0e", activeColor = "#028647", "data-codigo": dataCodigo, showLabel = true } = Astro.props;
---

<button
    class="led-button w-full px-1 py-2 text-sm font-medium text-black border-2 border-[#a6a6a6] rounded-full transition-colors h-8 flex items-center justify-center"
    data-col={colIndex}
    data-row={rowIndex}
    data-inactive-color={inactiveColor}
    data-active-color={activeColor}
    style={`background-color: ${inactiveColor};`}
    data-codigo={dataCodigo}
>
    {showLabel && label}
</button>