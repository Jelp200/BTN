---
// ControlButtonCalorMatrix.astro
---

<div class="bg-[#d9d9d9] rounded-lg p-2 flex flex-col gap-1" data-grupo="CALOR">
    <!-- Encabezado -->
    <div class="flex items-center justify-center gap-1">
        <img src="/icons/calor.svg" alt="Calor" class="w-4 h-4" />
        <span class="text-xs font-semibold text-gray-700 select-none">Calor</span>
    </div>

    <!-- Matriz 2x2 -->
    <div class="grid grid-cols-2 gap-0.5">
        <button
            class="calor-sub-btn py-0.5 bg-[#c8c8c8] hover:bg-[#a6a6a6] rounded text-xs font-semibold transition-all"
            data-calor-codigo="004"
            title="Calor bajo"
        >Bajo</button>
        <button
            class="calor-sub-btn py-0.5 bg-[#c8c8c8] hover:bg-[#a6a6a6] rounded text-xs font-semibold transition-all"
            data-calor-codigo="005"
            title="Calor medio"
        >Medio</button>
        <button
            class="calor-sub-btn py-0.5 bg-[#c8c8c8] hover:bg-[#a6a6a6] rounded text-xs font-semibold transition-all"
            data-calor-codigo="006"
            title="Calor alto"
        >Alto</button>
        <button
            class="calor-sub-btn py-0.5 bg-[#c8c8c8] hover:bg-[#a6a6a6] rounded text-xs font-semibold transition-all"
            data-calor-codigo="002"
            title="Apagar calor"
        >Apagado</button>
    </div>
</div>
