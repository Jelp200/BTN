---
// LedSection.astro

//* IMPORTS
import LedButton from "./LedButton.astro";
import DivisorLine from "../DivisorLine.astro";
---

<div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-3">
    <!-- Grupo A - Luz cálida -->
    <div class="space-y-1">
        <div class="flex flex-col gap-2">
            <LedButton
                label="Encendido luz cálida"
                colIndex="6"
                rowIndex="1"
                inactiveColor="#fff"
                activeColor="#a6a6a6"
                data-codigo="101"
            />
            <LedButton
                label="C1"
                colIndex="1"
                rowIndex="1"
                inactiveColor="#fd8c8c"
                activeColor="#ff3131"
                data-codigo="104"
                showLabel={false}
            />
            <DivisorLine />
            <LedButton
                label="C2"
                colIndex="2"
                rowIndex="1"
                inactiveColor="#f69c9c"
                activeColor="#ff5757"
                data-codigo="105"
                showLabel={false}
            />
            <LedButton
                label="C3"
                colIndex="3"
                rowIndex="1"
                inactiveColor="#ef955e"
                activeColor="#f47527"
                data-codigo="106"
                showLabel={false}
            />
            <LedButton
                label="C4"
                colIndex="4"
                rowIndex="1"
                inactiveColor="#ffd391"
                activeColor="#ffbd59"
                data-codigo="107"
                showLabel={false}
            />
            <LedButton
                label="C5"
                colIndex="5"
                rowIndex="1"
                inactiveColor="#fae692"
                activeColor="#ffde59"
                data-codigo="108"
                showLabel={false}
            />
        </div>
    </div>

    <!-- Grupo B - Luz fría -->
    <div class="space-y-2">
        <div class="flex flex-col gap-2">
            <LedButton
                label="Encendido luz fría"
                colIndex="6"
                rowIndex="2"
                inactiveColor="#fff"
                activeColor="#a6a6a6"
                data-codigo="102"
            />
            <LedButton
                label="F1"
                colIndex="1"
                rowIndex="2"
                inactiveColor="#5b7ba6"
                activeColor="#004aad"
                data-codigo="109"
                showLabel={false}
            />
            <DivisorLine />
            <LedButton
                label="F2"
                colIndex="2"
                rowIndex="2"
                inactiveColor="#92a6ff"
                activeColor="#5271ff"
                data-codigo="110"
                showLabel={false}
            />
            <LedButton
                label="F3"
                colIndex="3"
                rowIndex="2"
                inactiveColor="#8ed3fa"
                activeColor="#38b6ff"
                data-codigo="111"
                showLabel={false}
            />
            <LedButton
                label="F4"
                colIndex="4"
                rowIndex="2"
                inactiveColor="#aa8be8"
                activeColor="#6f31eb"
                data-codigo="112"
                showLabel={false}
            />
            <LedButton
                label="F5"
                colIndex="5"
                rowIndex="2"
                inactiveColor="#bea8e8"
                activeColor="#5500ff"
                data-codigo="113"
                showLabel={false}
            />
        </div>
    </div>

    <!-- Grupo C - Luz neutra -->
    <div class="space-y-2">
        <div class="flex flex-col gap-2">
            <LedButton
                label="Encendido luz neutra"
                colIndex="6"
                rowIndex="3"
                inactiveColor="#fff"
                activeColor="#a6a6a6"
                data-codigo="103"
            />
            <LedButton
                label="N1"
                colIndex="1"
                rowIndex="3"
                inactiveColor="#74b898"
                activeColor="#00bf63"
                data-codigo="114"
                showLabel={false}
            />
            <DivisorLine />
            <LedButton
                label="N2"
                colIndex="2"
                rowIndex="3"
                inactiveColor="#b0dd9d"
                activeColor="#7ed957"
                data-codigo="115"
                showLabel={false}
            />
            <LedButton
                label="N3"
                colIndex="3"
                rowIndex="3"
                inactiveColor="#d3f1ab"
                activeColor="#c1ff72"
                data-codigo="116"
                showLabel={false}
            />
            <LedButton
                label="N4"
                colIndex="4"
                rowIndex="3"
                inactiveColor="#b0fad4"
                activeColor="#72ffb7"
                data-codigo="117"
                showLabel={false}
            />
            <LedButton
                label="N5"
                colIndex="5"
                rowIndex="3"
                inactiveColor="#a2e1e4"
                activeColor="#c"
                data-codigo="118"
                showLabel={false}
            />
        </div>
    </div>

    <!-- Grupo D - Otros -->
    <div class="space-y-2">
        <div class="flex flex-col gap-2">
            <LedButton
                label="B+"
                colIndex="3"
                rowIndex="4"
                inactiveColor="#fff"
                activeColor="#e84e0e"
                data-codigo="121"
            />
            <LedButton
                label="B-"
                colIndex="4"
                rowIndex="4"
                inactiveColor="#fff"
                activeColor="#e84e0e"
                data-codigo="122"
            />
            <DivisorLine />
            <LedButton
                label="Strobo"
                colIndex="1"
                rowIndex="4"
                inactiveColor="#fff"
                activeColor="#e84e0e"
                data-codigo="119"
            />
            <LedButton
                label="Flash"
                colIndex="2"
                rowIndex="4"
                inactiveColor="#fff"
                activeColor="#e84e0e"
                data-codigo="120"
            />
            <LedButton
                label="Apagado total"
                colIndex="5"
                rowIndex="4"
                inactiveColor="#fff"
                activeColor="#e84e0e"
                data-codigo="100"
            />
        </div>
    </div>
</div>