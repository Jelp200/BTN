---
// ControlButtonCalor.astro

interface Props {
    label: string;
    icon: string;
    "data-codigo": string;
    estado?: "off" | "on" | "warning";
}

const {
    label,
    icon,
    "data-codigo": dataCodigo,
    estado = "off",
} = Astro.props as Props;

// Mapa de colores del LED
const ledColor =
    {
        off: "bg-gray-400",
        on: "bg-green-500",
        warning: "bg-yellow-400",
    }[estado] ?? "bg-gray-400";
---

<button
    class="control-btn relative flex flex-col items-center space-y-1 p-4 text-black hover:bg-[#a6a6a6] bg-[#d9d9d9] rounded-lg transition-all"
    data-codigo={dataCodigo}
>
    <!-- LED indicador -->
    <span
        class={`led-indicator absolute top-2 right-2 w-3 h-3 rounded-full ${ledColor} shadow`}
    ></span>

    <img src={`/icons/${icon}.svg`} alt={label} class="w-5 h-5 status-icon" />
    <span class="text-sm">{label}</span>
</button>
