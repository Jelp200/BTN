---
// ControlButtonCalor.astro

interface Props {
    label: string;
    icon: string;
    "data-codigo": string;
};

const {
    label,
    icon,
    "data-codigo": dataCodigo,
} = Astro.props as Props;

---

<button
    class="control-btn relative flex flex-col items-center space-y-1 p-4 text-black hover:bg-[#a6a6a6] bg-[#d9d9d9] rounded-lg transition-all"
    data-codigo={dataCodigo}
>
    <!-- LED indicador -->
    <span
        class={`led-superior absolute top-2 right-2 w-3 h-3 rounded-full bg-[#b4b4b4] shadow`}
    ></span>
    <span
        class={`led-medio absolute top-7 right-2 w-3 h-3 rounded-full bg-[#b4b4b4] shadow`}
    ></span>
    <span
        class={`led-inferior absolute top-12 right-2 w-3 h-3 rounded-full bg-[#b4b4b4] shadow`}
    ></span>

    <img src={`/icons/${icon}.svg`} alt={label} class="w-5 h-5 status-icon" />
    <span class="text-sm">{label}</span>
</button>
