---
//* IndicatorSection.astro *//

import ControlIndicador from "./ControlIndicador.astro";
import ControlButtonGraphic from "./ControlButtonGraphic.astro";
---

<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">

    {[
        { icon: "X",   sensor: "X"   },
        { icon: "Y",   sensor: "Y"   },
        { icon: "Z",   sensor: "Z"   },
        { icon: "T",   sensor: "T"   },
        { icon: "H",   sensor: "H"   },
        { icon: "UV",  sensor: "UV"  },
        { icon: "CO2", sensor: "CO2" },
        { icon: "O3",  sensor: "O3"  },
        { icon: "dB",  sensor: "dB"  },
    ].map(({ icon, sensor }) => (
        <div class="flex flex-col gap-2 p-3 rounded-lg shadow-md w-full">
            <ControlIndicador icon={icon} medicion="N/A" data-medicion={icon} />
            <ControlButtonGraphic data-sensor={sensor} />
        </div>
    ))}

</div>