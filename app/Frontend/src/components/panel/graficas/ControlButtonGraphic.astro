---
//* ControlButtonGraphic.astro *//

const { isActive = false, ...restProps } = Astro.props;
---

<!-- Botón -->
<div class="graphic-control flex items-center gap-2">
    <button
        type="button"
        {...restProps}
        class="graphic-btn w-full h-7.5 flex items-center justify-center space-x-2 px-3 py-2 bg-[#d9d9d9] hover:bg-[#a6a6a6] text-white rounded-lg transition-colors"
    >
        <img src="/icons/graphic.svg" class="w-5 h-5" alt="Graphic icon" />
    </button>
</div>