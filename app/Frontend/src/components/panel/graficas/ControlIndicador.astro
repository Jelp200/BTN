---
//* ControlIndicador.astro *//

const { icon, isActive = false, medicion = "N/A" } = Astro.props;
---

<!-- Botón + display juntos -->
<div class="control-indicador w-full flex items-center gap-2" data-medicion={icon}>
    <!-- Botón fijo (ícono) -->
    <button
        type="button"
        class="control-btn shrink-0 h-7.5 flex items-center justify-center px-3 py-2 bg-[#d9d9d9] hover:bg-[#a6a6a6] text-white rounded-lg transition-colors"
        data-codigo={icon}
    >
        <img src={`/icons/${icon}.svg`} class="w-5 h-5" alt={`Icono ${icon}`} />
    </button>

    <!-- Display de valor: crece para ocupar el ancho restante -->
    <div
        class="medicion-display flex-1 min-w-0 h-7.5 flex items-center justify-center bg-white border border-gray-300 text-sm text-gray-700 rounded-lg font-semibold"
        data-medicion={icon}
    >
        {medicion}
    </div>
</div>