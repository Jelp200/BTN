---
//* SelectedColorAndSmokeState.astro *//
---

<div class="mt-3 flex items-center gap-2">
    <!-- Círculo de color de cabina -->
    <div class="flex items-center gap-1">
        <div
            id="color-cabina"
            class="w-18 h-18 rounded-full bg-[#000] transition-colors duration-300"
            title="Último color seleccionado en LEDs"
        >
        </div>
        <span class="text-sm text-gray-700 font-medium">Color cabina</span>
    </div>

    <!-- Círculo de estado de humo -->
    <div class="flex items-center gap-2">
        <div
            id="estado-humo"
            class="w-18 h-18 rounded-full bg-[#ff4d4d] transition-all duration-300"
            title="Estado del humo: Rojo = No listo, Verde = Listo para disparar"
        >
        </div>
        <span class="text-sm text-gray-700 font-medium">Humo Listo</span>
    </div>
</div>