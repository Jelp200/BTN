---
// InfoModal.astro — Modal de información compartido entre pestañas del panel
---

<div
    id="info-modal"
    class="fixed inset-0 z-[80] hidden flex items-center justify-center"
    role="dialog"
    aria-modal="true"
    aria-labelledby="info-modal-title"
>
    <!-- Backdrop -->
    <div id="info-modal-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>

    <!-- Card -->
    <div class="relative z-10 bg-white rounded-xl shadow-2xl w-full max-w-2xl mx-4 max-h-[85vh] flex flex-col">

        <!-- Header: tabs de navegación + botón cerrar -->
        <div class="flex items-center justify-between border-b border-[#e0e0e0] px-5 pt-3 pb-0 shrink-0">
            <div class="flex gap-1" id="info-modal-title">
                <button data-modal-tab="controles"
                    class="info-modal-tab px-4 py-2 text-sm font-semibold rounded-t-lg border-b-2 border-[#1f497d] text-[#1f497d] transition-colors">
                    Controles
                </button>
                <button data-modal-tab="graficas"
                    class="info-modal-tab px-4 py-2 text-sm font-semibold rounded-t-lg border-b-2 border-transparent text-gray-400 hover:text-gray-600 transition-colors">
                    Sensores
                </button>
                <button data-modal-tab="biometria"
                    class="info-modal-tab px-4 py-2 text-sm font-semibold rounded-t-lg border-b-2 border-transparent text-gray-400 hover:text-gray-600 transition-colors">
                    Biometría
                </button>
            </div>
            <button id="close-info-modal"
                class="text-gray-400 hover:text-gray-700 p-1 rounded-md transition-colors mb-2"
                aria-label="Cerrar">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <!-- Área de contenido scrollable -->
        <div class="overflow-y-auto p-5 flex-1">

            <!-- ===== CONTROLES ===== -->
            <div data-modal-content="controles" class="flex flex-col gap-4">
                <div>
                    <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-widest mb-1">Panel de Controles</p>
                    <p class="text-sm text-gray-600">Activa y desactiva los sistemas físicos de la cabina. Los controles solo están disponibles cuando la cabina está <span class="font-semibold text-[#1f497d]">activa</span>.</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">❄️</span>
                        <div><p class="text-xs font-semibold text-gray-700">Frío</p><p class="text-xs text-gray-500 mt-0.5">Activa el sistema de enfriamiento. Al presionar Frío activo, presionar de nuevo lo apaga.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">🔥</span>
                        <div><p class="text-xs font-semibold text-gray-700">Calor (Bajo / Medio / Alto / Apagado)</p><p class="text-xs text-gray-500 mt-0.5">Control de calefacción en tres intensidades. Selecciona el nivel deseado directamente; <b>Apagado</b> detiene el calor.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">💧</span>
                        <div><p class="text-xs font-semibold text-gray-700">Humedad</p><p class="text-xs text-gray-500 mt-0.5">Activa el humidificador de la cabina.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">📳</span>
                        <div><p class="text-xs font-semibold text-gray-700">Vibración</p><p class="text-xs text-gray-500 mt-0.5">Activa el sistema de vibración de la silla.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">🌀</span>
                        <div><p class="text-xs font-semibold text-gray-700">Ventilador</p><p class="text-xs text-gray-500 mt-0.5">Activa el ventilador interno de la cabina.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">💨</span>
                        <div><p class="text-xs font-semibold text-gray-700">Extractor</p><p class="text-xs text-gray-500 mt-0.5">Activa el extractor de aire.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">🚿</span>
                        <div><p class="text-xs font-semibold text-gray-700">Deshumidificador</p><p class="text-xs text-gray-500 mt-0.5">Activa el deshumidificador de la cabina.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">💨</span>
                        <div><p class="text-xs font-semibold text-gray-700">Humo</p><p class="text-xs text-gray-500 mt-0.5">Activa el generador de humo de la cabina.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">⚡</span>
                        <div><p class="text-xs font-semibold text-gray-700">Disparo</p><p class="text-xs text-gray-500 mt-0.5">Activa el sistema de disparo de la cabina.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">🔊</span>
                        <div><p class="text-xs font-semibold text-gray-700">Sonidos</p><p class="text-xs text-gray-500 mt-0.5">Selecciona un sonido ambiental, tinitus o tono. El audio se reproduce de inmediato al seleccionarlo.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">⏱️</span>
                        <div><p class="text-xs font-semibold text-gray-700">Temporizador</p><p class="text-xs text-gray-500 mt-0.5">Configura el tiempo de la sesión. El contador hace regresiva hasta llegar a 00:00.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">💡</span>
                        <div><p class="text-xs font-semibold text-gray-700">Luces</p><p class="text-xs text-gray-500 mt-0.5">Control de iluminación LED RGB. Selecciona el color o modo (Strobo, Flash, Apagado total).</p></div>
                    </div>
                </div>

                <div class="bg-[#fff8e1] border border-[#ffe082] rounded-lg p-3">
                    <p class="text-xs font-semibold text-[#7c5e00] mb-1">Botones de acción principal</p>
                    <ul class="text-xs text-[#7c5e00] space-y-1">
                        <li>• <b>ACTIVAR CABINA</b> — Activa la cabina y habilita el control de todos sus sistemas.</li>
                        <li>• <b>PARAR Y RESET</b> — Detiene todos los sistemas activos y reinicia la cabina a su estado inicial.</li>
                    </ul>
                </div>
            </div>

            <!-- ===== SENSORES ===== -->
            <div data-modal-content="graficas" class="hidden flex flex-col gap-4">
                <div>
                    <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-widest mb-1">Panel de Sensores</p>
                    <p class="text-sm text-gray-600">Visualiza en tiempo real los datos que envían los sensores físicos de la cabina una vez que el microcontrolador está conectado.</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">📈</span>
                        <div><p class="text-xs font-semibold text-gray-700">Selección de gráfica</p><p class="text-xs text-gray-500 mt-0.5">Presiona uno de los botones de sensor para mostrar su señal. El botón activo se resalta en verde. Solo se puede visualizar una gráfica a la vez.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">🔄</span>
                        <div><p class="text-xs font-semibold text-gray-700">Refrescar gráfica</p><p class="text-xs text-gray-500 mt-0.5">Si conectas el microcontrolador después de iniciar la app y la gráfica no muestra datos, usa este botón para reiniciar la visualización.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">🔬</span>
                        <div><p class="text-xs font-semibold text-gray-700">Indicadores numéricos</p><p class="text-xs text-gray-500 mt-0.5">Muestran el valor actual de cada sensor (temperatura, presión, humedad, etc.) actualizado en tiempo real.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">🎨</span>
                        <div><p class="text-xs font-semibold text-gray-700">Estado LED y Humo</p><p class="text-xs text-gray-500 mt-0.5">Muestra el color activo del LED seleccionado y si el generador de humo está encendido.</p></div>
                    </div>
                </div>

                <div class="bg-[#e3f2fd] border border-[#90caf9] rounded-lg p-3">
                    <p class="text-xs font-semibold text-[#0d47a1] mb-1">Conectividad</p>
                    <p class="text-xs text-[#0d47a1]">Los sensores envían datos en cuanto el microcontrolador está conectado por USB/serial y la cabina está activa. Si no aparecen datos, verifica la conexión y usa el botón de refrescar.</p>
                </div>
            </div>

            <!-- ===== BIOMETRÍA ===== -->
            <div data-modal-content="biometria" class="hidden flex flex-col gap-4">
                <div>
                    <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-widest mb-1">Panel de Biometría</p>
                    <p class="text-sm text-gray-600">Monitorea los signos vitales del usuario en tiempo real mediante un dispositivo biométrico compatible.</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">❤️</span>
                        <div><p class="text-xs font-semibold text-gray-700">Pulso (BPM)</p><p class="text-xs text-gray-500 mt-0.5">Frecuencia cardíaca en latidos por minuto. Rango normal en reposo: <b>60 – 100 bpm</b>.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">🫁</span>
                        <div><p class="text-xs font-semibold text-gray-700">Oxigenación (SpO₂)</p><p class="text-xs text-gray-500 mt-0.5">Saturación de oxígeno en sangre. Rango normal: <b>95 – 100 %</b>.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">🌡️</span>
                        <div><p class="text-xs font-semibold text-gray-700">Temperatura corporal</p><p class="text-xs text-gray-500 mt-0.5">Temperatura del usuario. Rango normal: <b>36.1 – 37.2 °C</b>.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">💉</span>
                        <div><p class="text-xs font-semibold text-gray-700">Presión Arterial</p><p class="text-xs text-gray-500 mt-0.5">Presión sistólica/diastólica. Referencia normal: <b>120/80 mmHg</b>.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">📊</span>
                        <div><p class="text-xs font-semibold text-gray-700">Gráficas biométricas</p><p class="text-xs text-gray-500 mt-0.5">Visualizan la evolución temporal de cada signo vital. Selecciona la métrica deseada en el selector de la parte superior.</p></div>
                    </div>
                    <div class="flex items-start gap-3 bg-[#f7f7f7] rounded-lg p-3">
                        <span class="text-lg shrink-0">⌚</span>
                        <div><p class="text-xs font-semibold text-gray-700">Dispositivo biométrico</p><p class="text-xs text-gray-500 mt-0.5">Conecta el smartwatch o sensor compatible. El sistema detecta la conexión y comienza la transmisión automáticamente.</p></div>
                    </div>
                </div>

                <div class="bg-[#e8f5e9] border border-[#a5d6a7] rounded-lg p-3">
                    <p class="text-xs font-semibold text-[#1b5e20] mb-1">Cómo iniciar la medición</p>
                    <ol class="text-xs text-[#1b5e20] space-y-1 list-decimal list-inside">
                        <li>Asegúrate de que el dispositivo biométrico está conectado y emparejado.</li>
                        <li>Espera a que se realice la primera medición automática de calibración (BMP).</li>
                        <li>Selecciona el tipo de medición (Automática o Manual) que se encuentra a lado del titulo "Métricas Biométricas".</li>
                        <li>Espera a que se realicen las mediciones automáticas si seleccionaste el modo Automático, o realiza las mediciones manuales si seleccionaste el modo Manual (Selecciona la medición en el selector de la parte superior).</li>
                    </ol>
                </div>
            </div>

        </div>
    </div>
</div>

<script is:inline>
(function () {
    function openInfoModal(activeTab) {
        const modal = document.getElementById('info-modal');
        if (!modal) return;
        modal.classList.remove('hidden');
        switchModalTab(activeTab || 'controles');
    }

    function closeInfoModal() {
        document.getElementById('info-modal')?.classList.add('hidden');
    }

    function switchModalTab(tab) {
        document.querySelectorAll('[data-modal-content]').forEach(el => {
            el.classList.toggle('hidden', el.getAttribute('data-modal-content') !== tab);
        });
        document.querySelectorAll('[data-modal-tab]').forEach(btn => {
            const isActive = btn.getAttribute('data-modal-tab') === tab;
            btn.classList.toggle('border-[#1f497d]', isActive);
            btn.classList.toggle('text-[#1f497d]', isActive);
            btn.classList.toggle('border-transparent', !isActive);
            btn.classList.toggle('text-gray-400', !isActive);
        });
    }

    document.addEventListener('click', function (e) {
        // Abrir modal
        const infoBtn = e.target.closest('[data-action="open-info"]');
        if (infoBtn) {
            const panel = infoBtn.closest('.panel-container');
            const activeTabBtn = panel && panel.querySelector('[role="tab"][aria-selected="true"]');
            const activeTab = (activeTabBtn && activeTabBtn.getAttribute('data-tab')) || 'controles';
            openInfoModal(activeTab);
            return;
        }

        // Cerrar modal
        if (e.target.closest('#close-info-modal') || e.target.id === 'info-modal-backdrop') {
            closeInfoModal();
            return;
        }

        // Cambiar pestaña dentro del modal
        const modalTabBtn = e.target.closest('[data-modal-tab]');
        if (modalTabBtn) {
            switchModalTab(modalTabBtn.getAttribute('data-modal-tab'));
        }
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeInfoModal();
    });
})();
</script>
